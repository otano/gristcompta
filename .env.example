# Variables d'environnement requises par les scripts (voir README.md)
# Copie ce fichier en .env et renseigne les valeurs (jamais committées).

# Token API Grist (secret - ne pas committer)
GRIST_API_TOKEN=

# Identifiant du document Grist
GRIST_DOC_ID=

# URL de base de l'instance Grist (ex: https://docs.getgrist.com)
GRIST_BASE_URL=

# URL publique où est hébergé widget/creer_facture.html (configurer_widget.py)
GRIST_WIDGET_URL=
